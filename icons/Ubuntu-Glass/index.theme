[Icon Theme]
Name=Ubuntu-Glass
Comment=Rounded app tiles for the Ubuntu Glass theme
Inherits=Yaru,Adwaita,hicolor
Directories=scalable/apps,scalable/places,scalable/mimetypes,symbolic

[scalable/apps]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Applications

[scalable/places]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=Places

[scalable/mimetypes]
Size=64
MinSize=16
MaxSize=512
Type=Scalable
Context=MimeTypes

[symbolic]
Size=16
MinSize=8
MaxSize=512
Type=Scalable
Context=Status
